{
  "name": "e-learning-grade-a-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:user": "npm --prefix user-frontend run dev",
    "dev:admin": "npm --prefix admin-frontend run dev",
    "dev:backend": "cd backend && venv/bin/python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "db:migrate": "cd backend && venv/bin/alembic upgrade head",
    "db:revision": "cd backend && venv/bin/alembic revision --autogenerate -m"
  }
}
