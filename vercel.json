{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix user-frontend ci",
  "buildCommand": "npm --prefix user-frontend run build",
  "outputDirectory": "user-frontend/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
