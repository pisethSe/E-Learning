# Copy to backend/.env and fill in real values. Never commit .env files.
# All values are intentionally empty in this template.

DATABASE_URL=
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=grade_a_admin_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Set to false to hide /docs, /redoc, and /openapi.json (recommended in production).
ENABLE_API_DOCS=true

ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Format: Name|email|password;Name|email|password
ADMIN_BOOTSTRAP_ACCOUNTS=

# Comma-separated frontend origins allowed to call the API.
FRONTEND_ORIGINS=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_USERNAME=

STORAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=
