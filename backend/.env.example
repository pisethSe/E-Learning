# Local SQLite:
# DATABASE_URL=sqlite:///./e-learning.db

# Production PostgreSQL / Neon:
# Use this same value in the project root `.env` for local tooling.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=grade_a_admin_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Optional bootstrap account. When these are set and the user does not exist,
# the API creates the first admin on startup.
ADMIN_NAME=Grade A Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# Comma-separated frontend origins allowed to call the API.
# Keep local origins for development, add deployed frontend URLs in production.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174

TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHANNEL_USERNAME=bacii26w

# Keep SQLite for records, store uploaded files/images/audio/video in Cloudinary.
STORAGE_BACKEND=cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=e-learning-grade-a

# You can use CLOUDINARY_URL instead of the three credential fields above.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
